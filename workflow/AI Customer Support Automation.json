    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customers (\n    customer_name,\n    email,\n    total_tickets,\n    last_category,\n    last_priority,\n    last_sentiment,\n    last_contacted_at\n)\nVALUES (\n    '{{ $json.customer_name }}',\n    '{{ $json.email }}',\n    1,\n    '{{ $json.category }}',\n    '{{ $json.priority }}',\n    '{{ $json.sentiment }}',\n    NOW()\n)\nON CONFLICT (email)\nDO UPDATE SET\n    customer_name = EXCLUDED.customer_name,\n    total_tickets = customers.total_tickets + 1,\n    last_category = EXCLUDED.last_category,\n    last_priority = EXCLUDED.last_priority,\n    last_sentiment = EXCLUDED.last_sentiment,\n    last_contacted_at = NOW()\nRETURNING\n    id AS customer_id,\n    customer_name,\n    email,\n    total_tickets,\n    last_category AS category,\n    last_priority AS priority,\n    last_sentiment AS sentiment,\n    last_contacted_at,\n    '{{ $json.subject }}' AS subject,\n    '{{ $json.message }}' AS message,\n    '{{ $json.recommended_action }}' AS recommended_action,\n    '{{ $json.ai_response }}' AS ai_response,\nCASE\n    WHEN '{{ $json.escalation_required }}' = 'true' THEN TRUE\n    ELSE FALSE\nEND AS escalation_required,\n    '{{ $json.escalation_reason }}' AS escalation_reason;",
        "options": {}
      },
