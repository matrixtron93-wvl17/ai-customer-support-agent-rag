    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI customer support agent for a business.\n\nAnalyze the customer's support request and provide a helpful and accurate response.\n\nCustomer Name:\n{{ $json.customer_name }}\n\nEmail:\n{{ $json.email }}\n\nSubject:\n{{ $json.subject }}\n\nCustomer Message:\n{{ $json.message }}\n\nIMPORTANT:\n- Use the connected knowledge base (RAG tool) to find relevant information before answering.\n- Do not invent policies, pricing, refund decisions, account details, or technical information.\n- If the knowledge base does not contain enough information, clearly state that the request requires human support.\n- Never ask the customer for passwords, authentication codes, or sensitive credentials.\n- Keep the response professional, concise, and suitable for sending directly to the customer.\n\nDetermine:\n1. Category of the support request\n2. Priority: Low, Medium, or High\n3. Sentiment: Positive, Neutral, or Negative\n4. Recommended action\n5. Final customer response\n\nReturn the result in this format:\n\nCategory: [category]\nPriority: [Low/Medium/High]\nSentiment: [Positive/Neutral/Negative]\nRecommended Action: [action]\nCustomer Response: [response]",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        704,
        -176
      ],
      "id": "2a5438c1-f66d-494e-b2ef-84b0b1df1fd3",
      "name": "AI Support Agent"
    },
    {
      "parameters": {
        "jsCode": "const ai = $json.output || \"\";\n\nconst category = ai.match(/Category:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst priority = ai.match(/Priority:\\s*(.+)/i)?.[1]?.trim() || \"\";\nconst sentiment = ai.match(/Sentiment:\\s*(.+)/i)?.[1]?.trim() || \"\";\n\nconst recommendedAction =\n  ai.match(/Recommended Action:\\s*(.+)/i)?.[1]?.trim() || \"\";\n\nconst customerResponse =\n  ai.split(/Customer Response:\\s*/i)[1]?.trim() || \"\";\n\nconst ticket = $('Prepare Customer Ticket').item.json;\n\nconst message = ticket.message.toLowerCase();\nconst categoryLower = category.toLowerCase();\nconst priorityLower = priority.toLowerCase();\n\n// Human escalation rules\nconst securityIssue =\n  categoryLower.includes(\"security\") ||\n  message.includes(\"hacked\") ||\n  message.includes(\"unauthorized\") ||\n  message.includes(\"accessed my account\");\n\nconst refundRequest =\n  categoryLower.includes(\"refund\") ||\n  message.includes(\"refund\");\n\nconst highPriority =\n  priorityLower === \"high\";\n\nconst paymentStillFailing =\n  categoryLower.includes(\"payment\") &&\n  (\n    message.includes(\"still failing\") ||\n    message.includes(\"continues to fail\") ||\n    message.includes(\"failed again\") ||\n    message.includes(\"tried again\") ||\n    message.includes(\"retry\") ||\n    message.includes(\"multiple times\")\n  );\n\nconst loginStillBlocked =\n  categoryLower.includes(\"login\") &&\n  (\n    message.includes(\"still cannot\") ||\n    message.includes(\"still can't\") ||\n    message.includes(\"reset\") ||\n    message.includes(\"after resetting\")\n  );\n\nconst escalationRequired =\n  highPriority ||\n  securityIssue ||\n  refundRequest ||\n  paymentStillFailing ||\n  loginStillBlocked;\n\nlet escalationReason = \"\";\n\nif (securityIssue) {\n  escalationReason = \"Security-related issue requires human support.\";\n} else if (refundRequest) {\n  escalationReason = \"Refund request requires human review.\";\n} else if (paymentStillFailing) {\n  escalationReason = \"Payment continues to fail after troubleshooting.\";\n} else if (loginStillBlocked) {\n  escalationReason = \"Customer still cannot access the account after troubleshooting.\";\n} else if (highPriority) {\n  escalationReason = \"High-priority support request requires human attention.\";\n}\n\nreturn [{\n  json: {\n    customer_name: ticket.customer_name,\n    email: ticket.email,\n    subject: ticket.subject,\n    message: ticket.message,\n    category,\n    priority,\n    sentiment,\n    recommended_action: recommendedAction,\n    ai_response: customerResponse,\n    escalation_required: escalationRequired,\n    escalation_reason: escalationReason\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        -176
      ],
      "id": "fc122427-6d22-4d32-8884-a5fe6caf9b3d",
